# Modèle de configuration de PRODUCTION (copier en infra/.env, jamais versionné). Les valeurs « À_FOURNIR » viennent de la DSI.
# Vérification avant ouverture : docker compose -f infra/docker-compose.yml --profile deploy run --rm preflight
APP_NAME="SAIE-CEEAC"
APP_ENV=production
# docker compose -f infra/docker-compose.yml run --rm --no-deps api php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# ex. https://saie.ceeac-eccas.org
APP_URL=https://À_FOURNIR
# même domaine que APP_URL (API-05)
FRONTEND_URL=https://À_FOURNIR
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# DB_HOST et DB_PORT sont fixés par docker-compose.yml (service postgres).
DB_CONNECTION=pgsql
DB_DATABASE=saie_ceeac
# Trois comptes : saie_admin (superutilisateur, administration seule), saie (propriétaire du schéma, migrations),
# saie_app (application, lecture et écriture des données seulement). Mots de passe distincts et longs.
# Seul le mot de passe du compte applicatif figure ici. Ceux du superutilisateur et du propriétaire sont des secrets
# Docker (infra/secrets/db-admin-password, infra/secrets/db-owner-password), jamais transmis aux conteneurs applicatifs.
DB_USERNAME=saie_app
SAIE_APP_PASSWORD=À_FOURNIR
DB_PASSWORD=${SAIE_APP_PASSWORD}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Préfixe __Host- : cookie lié au seul domaine, en HTTPS, sur tout le site (ASVS 5.0 V3.3).
SESSION_COOKIE=__Host-saie_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# nom d'hôte seul, ex. saie.ceeac-eccas.org
SANCTUM_STATEFUL_DOMAINS=À_FOURNIR
# Origines autorisées à appeler l’API (HTTPS, séparées par des virgules) ; contrôlé par preflight.
CORS_ALLOWED_ORIGINS=https://À_FOURNIR

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# QUEUE_CONNECTION et CACHE_STORE (redis) sont fixés par docker-compose.yml.
REDIS_CLIENT=phpredis
# Mot de passe Redis (long, aléatoire) : openssl rand -hex 32
REDIS_PASSWORD=À_FOURNIR

# SMTP institutionnel (NOT-02).
MAIL_MAILER=smtp
MAIL_HOST=À_FOURNIR
MAIL_PORT=587
MAIL_SCHEME=null
# STARTTLS obligatoire : un serveur qui ne propose pas TLS est refusé (ASVS 5.0 V12.3).
MAIL_REQUIRE_TLS=true
MAIL_USERNAME=À_FOURNIR
MAIL_PASSWORD=À_FOURNIR
MAIL_FROM_ADDRESS="saie@ceeac-eccas.org"
MAIL_FROM_NAME="SAIE-CEEAC"

# Paramètres SAIE (config/saie.php). Antivirus et chemin de la clé de signature sont fixés par docker-compose.yml.
SAIE_TIMEZONE=Africa/Libreville
SAIE_DEMO_MODE=false
SAIE_MFA_ENFORCED=true
SAIE_OFFLINE_PUBLIC_H=24
SAIE_OFFLINE_INTERNAL_H=1
# ex. mk-2026-11 ; changer à chaque rotation de clé (réappairage des lecteurs)
SAIE_MANIFEST_KEY_ID=À_FOURNIR

# Images de la pile figées par version ET empreinte (prérequis de production n° 5) : la pile refuse de démarrer sans elles.
# Relever l'empreinte : voir docs/exploitation/fiche-intervention-recette.md § 1 (la commande affiche directement nom:étiquette@sha256:…).
# Format attendu : nom:étiquette@sha256:<64 caractères hexadécimaux>. Contrôlé par php artisan saie:preflight.
SAIE_VERSION=À_FOURNIR
SAIE_IMAGE_PHP=php:8.4.À_FOURNIR-fpm-bookworm@sha256:À_FOURNIR
SAIE_IMAGE_NODE=node:22.À_FOURNIR-bookworm@sha256:À_FOURNIR
SAIE_IMAGE_NGINX=nginx:1.27.À_FOURNIR-alpine@sha256:À_FOURNIR
SAIE_IMAGE_POSTGRES=postgres:18.À_FOURNIR@sha256:À_FOURNIR
SAIE_IMAGE_REDIS=redis:7.À_FOURNIR-alpine@sha256:À_FOURNIR
SAIE_IMAGE_CLAMAV=clamav/clamav:1.À_FOURNIR@sha256:À_FOURNIR

# Notifications push (NOT-03), facultatives : php artisan saie:vapid, puis activer le canal en V39.
SAIE_VAPID_SUBJECT=mailto:dsi@ceeac-eccas.org
SAIE_VAPID_PUBLIC_KEY=
SAIE_VAPID_PRIVATE_KEY=

# Conversions facultatives (DOC-01) : binaires absents de l'image standard.
SAIE_SOFFICE_PATH=
SAIE_FFPROBE_PATH=
SAIE_FFMPEG_PATH=
